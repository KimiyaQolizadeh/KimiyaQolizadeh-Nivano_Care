# Database
DB_USER=nivano_user
DB_PASSWORD=nivano_password
DB_NAME=nivano_db
POSTGRES_PORT=5432

# JWT
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173

# Public service URLs used by the browser/frontend
VITE_AUTH_API_URL=http://localhost:8001
VITE_USER_API_URL=http://localhost:8002
VITE_SHIFT_API_URL=http://localhost:8003
VITE_COMPLIANCE_API_URL=http://localhost:8004

# Public URL used in generated credential document links
COMPLIANCE_PUBLIC_URL=http://localhost:8004

# Host ports
FRONTEND_PORT=5173
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
SHIFT_SERVICE_PORT=8003
COMPLIANCE_SERVICE_PORT=8004

# Environment label
ENVIRONMENT=development
