# Oracle Cloud Ubuntu VM deployment template.
# Copy to .env on the server and replace CHANGE_ME values.

# Database
DB_USER=nivano_user
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DB_NAME=nivano_db

# JWT
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Replace VM_PUBLIC_IP_OR_DOMAIN with your Oracle VM public IP or DNS name.
PUBLIC_BASE_URL=http://VM_PUBLIC_IP_OR_DOMAIN

# CORS origins allowed by FastAPI services.
# Add HTTPS origin here if you place Nginx/TLS in front later.
CORS_ORIGINS=http://VM_PUBLIC_IP_OR_DOMAIN:5173

# Browser-facing API URLs baked into the Vite frontend at build time.
VITE_AUTH_API_URL=http://VM_PUBLIC_IP_OR_DOMAIN:8001
VITE_USER_API_URL=http://VM_PUBLIC_IP_OR_DOMAIN:8002
VITE_SHIFT_API_URL=http://VM_PUBLIC_IP_OR_DOMAIN:8003
VITE_COMPLIANCE_API_URL=http://VM_PUBLIC_IP_OR_DOMAIN:8004

# Public URL stored for uploaded credential document links.
COMPLIANCE_PUBLIC_URL=http://VM_PUBLIC_IP_OR_DOMAIN:8004

# Host ports
FRONTEND_PORT=5173
AUTH_SERVICE_PORT=8001
USER_SERVICE_PORT=8002
SHIFT_SERVICE_PORT=8003
COMPLIANCE_SERVICE_PORT=8004

# Recommended for production: do not publish Postgres publicly.
# Keep 5432 closed in Oracle security lists/NSGs even if this port is mapped.
POSTGRES_PORT=5432

ENVIRONMENT=production
